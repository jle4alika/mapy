# Скопируйте в .env (в этой же папке) и подправьте значения.

# --- API / окружение ---
API_PORT=8000
# Воркеры uvicorn (каждый — свой процесс и свой пул SQLAlchemy при прямом Postgres)
API_WORKERS=4
NGINX_PORT=80
ENVIRONMENT=development
LOG_LEVEL=INFO
# За nginx выставьте true, чтобы rate limit брал IP из X-Forwarded-For
TRUST_PROXY_HEADERS=false
# CORS для Expo web (через запятую). Пусто в development = localhost:8081 и т.п.
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# JWT / fastapi-users (в production обязателен свой секрет!)
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_LONG_SECRET
JWT_ACCESS_EXPIRE_MINUTES=30

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=15432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=blink20
DB_USE_PGBOUNCER=false
# DB_TEST_URL=
# DB_DIRECT_HOST=localhost
# DB_DIRECT_PORT=15432
# DB_MIGRATE_ON_STARTUP=false
# DB_CREATE_ALL_ON_STARTUP=false
# Пул приложения (прямой Postgres). 4 воркера × (20+30) = 200 ≤ max_connections 300
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Образ Postgres с PostGIS (deploy/services/postgres.yml)
POSTGRES_IMAGE=postgis/postgis:16-3.4

# Локальные файлы (аватары, вложения)
STORAGE_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media

# PgBouncer (docker / prod). Клиенты → PB → небольшой пул к Postgres
PB_MAX_CLIENTS=2000
PB_DEFAULT_POOL_SIZE=50
PB_MIN_POOL_SIZE=10
PB_RESERVE_POOL_SIZE=25
PB_POOL_MODE=transaction
PGBOUNCER_PORT=16432
POSTGRES_PUBLISHED_PORT=15432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_OPTIONAL=true
REDIS_GUI_PORT=5540

# Глобальный rate limit (на IP). Для бенчмарка ёмкости: RATE_LIMIT_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=1

# --- Cache (fastapi-cache2) ---
CACHE_NAMESPACE_ME=me
CACHE_NAMESPACE_USER=get-user
CACHE_EXPIRE_SECONDS=60

# --- SMTP (reset/verify email) ---
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
SMTP_TIMEOUT=30

# --- RabbitMQ ---
RMQ_HOST=localhost
RMQ_PORT=5672
RMQ_MANAGEMENT_PORT=15672
RMQ_LOGIN=guest
RMQ_PASS=guest

# --- Celery (опционально) ---
# Раскомментируй, чтобы поднять worker + celery-exporter вместе со стеком:
# COMPOSE_PROFILES=celery
# Либо: make up-dev-celery / make up-prod-celery
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_DEFAULT_QUEUE=celery

# --- Monitoring (доступ через nginx: /grafana/) ---
# GRAFANA_ROOT_URL=http://localhost/grafana/
# GRAFANA_DOMAIN=localhost
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
